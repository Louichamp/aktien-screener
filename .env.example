# --- Datenbank / Queue ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockresearch
REDIS_URL=redis://localhost:6379

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# --- Universum -----------------------------------------------------------
# Komma-separierte Watchlist, die der Cron-/Orchestrator-Lauf verarbeitet.
WATCHLIST=AAPL,MSFT,NVDA,ASML,KO,PG

# --- Markt-Daten-Provider ------------------------------------------------
DATA_PROVIDER=yahoo         # yahoo (gratis, kein Key) | fmp
NEWS_PROVIDER=yahoo         # yahoo | fmp
YF_PERIOD=2y                # Yahoo: Historien-Tiefe (für EMA200 etc.)
YF_MAX_CONCURRENCY=8        # Yahoo: parallele Abrufe (gedrosselt)

# --- Financial Modeling Prep (nur bei DATA_PROVIDER=fmp) ------------------
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/api/v3
FMP_RATE_LIMIT=300          # Anfragen/Minute
FMP_MAX_CONCURRENCY=8       # parallele Requests
FMP_HISTORY_DAYS=300        # Kerzen-Tiefe für Indikatoren

# --- Kronos (PyTorch/Transformers) ---------------------------------------
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=cuda:0        # oder "cpu"
KRONOS_MAX_CONTEXT=512
KRONOS_LOOKBACK=400
KRONOS_SAMPLES=30           # Sampling-Durchläufe für das Konfidenzband
KRONOS_TOP_P=0.9
KRONOS_TEMP=1.0
KRONOS_CONFIDENCE_Z=1.28    # Bandbreite in Std (~80 %)

# --- Forecast-Resilienz (Worker) -----------------------------------------
FORECAST_HORIZON=30
FORECAST_ATTEMPTS=3
FORECAST_TIMEOUT=45
FORECAST_BACKOFF=1.5

# --- Batch-Orchestrierung (Worker) ---------------------------------------
SCREENER_BATCH_SIZE=50      # Ticker je Ingest-/Forecast-Sub-Job
INGEST_JOB_TIMEOUT=300
FORECAST_JOB_TIMEOUT=1200
COMPUTE_JOB_TIMEOUT=1800
ORCHESTRATOR_TIMEOUT=3600

# --- News-Cache (API) ----------------------------------------------------
NEWS_CACHE_TTL=300          # Sekunden, die News pro Ticker gecacht werden

# --- Frontend (Next.js) --------------------------------------------------
# Im frontend/ separat als .env.local setzen:
# NEXT_PUBLIC_API_BASE=http://localhost:8000
